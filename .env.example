# Optional RGB_L1 regtest stand overrides.
# Copy to .env.local to customize. Defaults match the local engine test stand.
# The RGB proxy must support protocol 1.0 (rgb-proxy-server 0.4.0+).
# For static deployments, provide absolute browser-accessible URLs or matching
# reverse proxies; Vite development proxies are not included in the build.

# VITE_RGB_L1_INDEXER_URL=/rgb-l1-esplora/regtest/api
# VITE_RGB_L1_PROXY_URL=/rgb-l1-proxy/json-rpc
# VITE_RGB_L1_INDEXER_TARGET=http://127.0.0.1:8094
# VITE_RGB_L1_PROXY_TARGET=http://127.0.0.1:3002
# VITE_RGB_L1_HELPER_TARGET=http://127.0.0.1:8080
# VITE_RGB_L1_VSS_TARGET=http://127.0.0.1:8181

# To enable cloud backups, enter /vss or an absolute VSS URL when creating a
# wallet in the UI. A blank VSS URL keeps cloud backups disabled.
